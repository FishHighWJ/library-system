# 图书馆管理系统 - 环境变量配置示例
# 使用方式：cp .env.example .env，然后填入真实值
# .env 文件已加入 .gitignore，不会被提交到版本库

# ============ 必须修改（生产环境） ============

# Flask Session 加密密钥（生产环境务必替换为 64 字节随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-to-a-random-64-bytes-hex-string

# 管理员初始密码（仅首次启动创建 admin 账号时使用，后续可在个人中心修改）
# 生产环境务必替换为强密码（建议 12 位以上，含大小写数字符号）
ADMIN_PASSWORD=change-me-to-a-strong-password

# 读者初始密码（同上）
READER_PASSWORD=change-me-to-a-strong-password

# ============ 可选（按需配置） ============

# Flask 配置环境：development / production / testing
# Docker 部署默认 production，本地开发默认 development
FLASK_CONFIG=development

# 数据库连接 URI
# 开发默认 SQLite：sqlite:///library.db
# 生产建议 MySQL/PostgreSQL：
#   mysql+pymysql://user:password@host:3306/library_db?charset=utf8mb4
#   postgresql://user:password@host:5432/library_db
# Docker 部署时已配置为 sqlite:///data/library.db（挂载到宿主机持久化）
# DATABASE_URL=sqlite:///library.db

# Session Cookie 安全标志（生产环境 HTTPS 必须设为 true）
SESSION_SECURE=false
